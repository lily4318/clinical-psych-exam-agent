{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clinical Psych Parallel Exam",
  "type": "object",
  "required": ["form","version","items","quality_status"],
  "properties": {
    "form": {"enum":["甲卷","乙卷"]},
    "version": {"type":"string"},
    "items": {
      "type":"array",
      "minItems":20,
      "maxItems":20,
      "items": {"$ref":"item.schema.json"}
    },
    "quality_status": {"enum":["草稿","待複核","已核可"]},
    "approved_by_user": {"type":"boolean"}
  }
}
